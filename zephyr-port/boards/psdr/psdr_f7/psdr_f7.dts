/*
 * Portable SDR F7 — Michael R. Colton design, STM32F756VGTx, LQFP100.
 * HSE 26 MHz on PH0/PH1, PLL → SYSCLK 216 MHz.
 *
 * Pin labels follow the original Hardware/STM32F756_Config.ioc.
 * Phase 1 brings up: console UART + status LEDs. Display, ADC, DAC,
 * I2C, SPI, timers all come later.
 */

/dts-v1/;
#include <st/f7/stm32f756Xg.dtsi>
#include <st/f7/stm32f756vgtx-pinctrl.dtsi>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "Portable SDR F7";
	compatible = "psdr,psdr-f7";

	chosen {
		zephyr,console = &usart1;
		zephyr,shell-uart = &usart1;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,dtcm = &dtcm;
	};

	leds: leds {
		compatible = "gpio-leds";

		white_led: led_white {
			gpios = <&gpioe 12 GPIO_ACTIVE_HIGH>;
			label = "LED_WHITE";
		};

		red_led: led_red {
			gpios = <&gpioe 13 GPIO_ACTIVE_HIGH>;
			label = "LED_RED";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		boot1_pin: boot1 {
			gpios = <&gpioa 1 GPIO_ACTIVE_HIGH>;
			label = "BOOT1";
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	aliases {
		led0 = &white_led;
		led1 = &red_led;
		sw0 = &boot1_pin;
	};

	/*
	 * App-facing handle on the RX I/Q channels. Refer to these via
	 * ADC_DT_SPEC_GET_BY_IDX(DT_PATH(zephyr_user), 0) for I and 1 for Q.
	 */
	zephyr,user {
		io-channels = <&adc1 3>, <&adc2 2>;
		io-channel-names = "rx_i", "rx_q";
	};
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(26)>;
	status = "okay";
};

&pll {
	div-m = <13>;
	mul-n = <216>;
	div-p = <2>;
	div-q = <9>;
	clocks = <&clk_hse>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(216)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <4>;
	apb2-prescaler = <2>;
};

&usart1 {
	pinctrl-0 = <&usart1_tx_pb6 &usart1_rx_pb7>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

/*
 * RX I/Q: Tayloe detector outputs land on PA3 (I) and PA2 (Q).
 * Hardware-correct mapping is ADC1_IN3 + ADC2_IN2. The original
 * firmware used ADC3 for Q which is a silent bug — PA2 is not
 * routed to ADC3 on the F756.
 */
&adc1 {
	pinctrl-0 = <&adc1_in3_pa3>;
	pinctrl-names = "default";
	st,adc-prescaler = <4>;
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@3 {
		reg = <3>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 15)>;
		zephyr,resolution = <12>;
	};
};

&adc2 {
	pinctrl-0 = <&adc2_in2_pa2>;
	pinctrl-names = "default";
	st,adc-prescaler = <4>;
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 15)>;
		zephyr,resolution = <12>;
	};
};
